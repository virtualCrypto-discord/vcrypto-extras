{
  "name": "vcrypto-extras",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The features virtualCrypto deliberately keeps out of its core, as an external application",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "register-application": "node scripts/register-application.ts",
    "register-commands": "node scripts/register-commands.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}

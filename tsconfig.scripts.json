{
  // The one-shot scripts run under Node (`node scripts/...ts`), not in the
  // worker, so they are checked against Node's types. They import from `src/`,
  // which is why every module there stays runnable by Node's type stripping:
  // explicit `.ts` extensions, and `erasableSyntaxOnly` in force both here and
  // in the worker's own config.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Both sets, because the scripts' import graph reaches into `src/`, whose
    // shared modules name Cloudflare globals in their signatures (`DB:
    // D1Database`). The scripts' own code is still Node's — that is what it
    // runs on — and the two sets coexist in this program without a clash.
    "types": ["node", "@cloudflare/workers-types"],

    "strict": true,
    "noUncheckedIndexedAccess": true,

    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["scripts"]
}

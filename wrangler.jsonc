{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vcrypto-extras",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  // The public half of the configuration, checked into the repository. The two
  // secrets beside it are `wrangler secret put` values: VCRYPTO_CLIENT_SECRET
  // and DISCORD_BOT_TOKEN. See docs/operations.md.
  "vars": {
    "VCRYPTO_BASE_URL": "https://vcrypto.sumidora.com",
    "VCRYPTO_CLIENT_ID": "6fd1ad91-0b92-434a-9b6a-51fbb0e0a7ec",
    "VCRYPTO_PUBLIC_KEY": "a0983bcf39bfc3c87e263771974bb53aa0f01b0d9cddee2a56db7a998340da65",
    "DISCORD_APPLICATION_ID": "1558852595223756842",
    "DISCORD_PUBLIC_KEY": "6e619c5d706d8cf24a3a9a2cdbead77d509efc8a40944d3fe6ff34bed1ed757e"
  },
  // The guild tokens a guild-side feature issues with, and the device-flow asks
  // that produce them (`src/vc/guild-grant.ts`). Local development and the
  // tests use their own copy of the directory.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vcrypto-extras",
      "database_id": "b6c2b56a-dd57-4912-90fd-5bf0b35e1fa9"
    }
  ],
  "triggers": {
    // Once a minute: pick up the grants administrators have approved since the
    // last tick, so a command run after the approval finds a token instead of
    // an ask it would have to poll itself.
    "crons": ["* * * * *"]
  },
  // One Durable Object per `/issue-role` run: the run's own state, its own
  // alarm, and a single writer for "who has been paid" — which is what lets a
  // distribution show progress and continue by itself (docs/issue-role.md).
  // SQLite-backed, which is what the free plan deploys.
  "durable_objects": {
    "bindings": [
      {
        "name": "ISSUE_RUNS",
        "class_name": "IssueRun"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["IssueRun"]
    }
  ]
}
